<section class="collection-head"><p class="eyebrow">THE ARCHIVE</p><h1><%= is_category() ? page.category : is_tag() ? page.tag : '文章索引' %></h1><p>共 <%= page.posts.length %> 篇文章。從一個問題開始，沿著好奇心讀下去。</p><div class="topic-links"><a href="/archives/" <%- !is_category() && !is_tag() ? 'aria-current="page"' : '' %>>全部</a><% site.categories.forEach(c=> { %><a href="<%= url_for(c.path) %>" <%- page.category === c.name ? 'aria-current="page"' : '' %>><%= c.name %> <span><%= c.length %></span></a><% }); %></div></section>
<% let year = ''; const groups = []; page.posts.sort('-date').forEach(post=> { const current=post.date.format('YYYY'); if(current!==year) { groups.push({year:current,posts:[]}); year=current; } groups.at(-1).posts.push(post); }); groups.forEach(group=> { %><section class="archive-year"><h2 class="year-label"><%= group.year %></h2><%- partial('_partial/post-list',{posts:group.posts}) %></section><% }); %><%- paginator({prev_text:'上一頁',next_text:'下一頁'}) %>
