<% const issue = issue_number(page); const issueURL = issue ? `https://github.com/${theme.comments.repo}/issues/${issue}` : `https://github.com/${theme.comments.repo}/issues/new?title=${encodeURIComponent(page.title)}&body=${encodeURIComponent('文章：'+page.permalink+'\n\n')}`; %>
<section class="engagement" data-engagement data-post-path="/<%= page.path %>" data-likes-endpoint="<%= theme.likes_endpoint %>" data-issue="<%= issue || '' %>" data-repo="<%= theme.comments.repo %>"><div class="engagement-actions"><% if(theme.likes_endpoint){ %><button class="like-button" type="button" data-like aria-pressed="false" disabled><%- icon('heart') %><span>喜歡這篇</span><span data-like-count></span></button><% } %><button class="share-button" type="button" data-share><%- icon('link') %> 複製連結</button><a class="text-link" href="<%= issueURL %>" target="_blank" rel="noopener noreferrer"><%- icon('message-circle') %> 留下想法</a></div><p class="engagement-status" data-like-status role="status"></p>
<% if(theme.support_url){ %><div class="support-note"><div><h2>支持這裡的書寫</h2><p>如果文章對你有幫助，歡迎請我喝杯咖啡。</p></div><a href="<%= theme.support_url %>" target="_blank" rel="noopener noreferrer"><%- icon('coffee') %> 請我喝杯咖啡 <%- icon('arrow-up-right') %></a></div><% } %>
<div class="discussion"><h2>一起討論</h2><p>歡迎分享想法、補充資料，或留下你的問題。留言時使用 GitHub 帳號登入。</p><% if(theme.giscus.enabled){ %><div class="giscus"></div><script src="https://giscus.app/client.js" data-repo="<%= theme.comments.repo %>" data-repo-id="<%= theme.giscus.repo_id %>" data-category="<%= theme.giscus.category %>" data-category-id="<%= theme.giscus.category_id %>" data-mapping="pathname" data-strict="1" data-reactions-enabled="0" data-emit-metadata="0" data-input-position="top" data-theme="preferred_color_scheme" data-lang="zh-TW" data-loading="lazy" crossorigin="anonymous" async></script><% } else { %><div class="discussion-comments" data-comments></div><a class="discussion-link" href="<%= issueURL %>" target="_blank" rel="noopener noreferrer">在 GitHub 參與討論 <%- icon('arrow-up-right') %></a><% } %></div></section>
