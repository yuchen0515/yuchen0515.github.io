<% const issue = issue_number(page); const commentsEnabled = theme.comments.enabled !== false; const commentsReady = theme.giscus.enabled && theme.giscus.repo_id && theme.giscus.category && theme.giscus.category_id; const issueURL = issue ? `https://github.com/${theme.comments.repo}/issues/${issue}` : null; %>
<section class="engagement" data-engagement data-post-path="/<%= page.path %>" data-likes-endpoint="<%= theme.likes_endpoint %>" data-issue="<%= issue || '' %>" data-repo="<%= theme.comments.repo %>"><div class="engagement-actions"><% if(theme.likes_endpoint){ %><button class="like-button" type="button" data-like aria-pressed="false" disabled><%- icon('heart') %><span>喜歡這篇</span><span data-like-count></span></button><% } %><button class="share-button" type="button" data-share><%- icon('link') %> 複製連結</button><% if(commentsEnabled){ %><a class="text-link" href="#discussion" data-open-comments><%- icon('message-circle') %> 留下想法</a><% } %></div><p class="engagement-status" data-like-status role="status"></p>
<% if(theme.support_url){ %><div class="support-note"><div><h2>支持這裡的書寫</h2><p>如果文章對你有幫助，歡迎請我喝杯咖啡。</p></div><a href="<%= theme.support_url %>" target="_blank" rel="noopener noreferrer"><%- icon('coffee') %> 請我喝杯咖啡 <%- icon('arrow-up-right') %></a></div><% } %>
<% if(commentsEnabled){ %>
<section class="discussion" id="discussion" aria-labelledby="discussion-heading">
  <h2 id="discussion-heading">一起討論</h2>
  <p>歡迎分享想法、補充資料，或留下你的問題。<% if(commentsReady){ %>使用 GitHub 帳號登入後，即可在這裡留言。<% } %></p>
  <p class="discussion-status" data-comment-status role="status" aria-live="polite"><%= commentsReady ? '留言將在這裡載入。' : '留言功能正在設定中。' %></p>
  <div class="giscus discussion-widget" id="discussion-comments" data-comment-widget data-comment-configured="<%= Boolean(commentsReady) %>" data-comment-repo-id="<%= theme.giscus.repo_id %>" data-comment-category="<%= theme.giscus.category %>" data-comment-category-id="<%= theme.giscus.category_id %>" aria-busy="false" <% if(!commentsReady){ %>hidden<% } %>></div>
  <button class="discussion-retry share-button" type="button" data-comment-retry hidden>重新載入留言</button>
  <% if(issueURL){ %><a class="discussion-link" href="<%= issueURL %>" data-comment-fallback target="_blank" rel="noopener noreferrer" <% if(commentsReady){ %>hidden<% } %>>查看留言原始討論 <%- icon('arrow-up-right') %></a><% } %>
  <noscript><p><%= commentsReady ? '啟用 JavaScript 後，即可在這裡閱讀與留言。' : '留言功能正在設定中。' %><% if(issueURL){ %>也可<a href="<%= issueURL %>" target="_blank" rel="noopener noreferrer">查看原始討論</a>。<% } %></p></noscript>
</section>
<% } %></section>
