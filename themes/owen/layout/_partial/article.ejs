<% const headings = content_toc(page.content); const bilingual = /data-language="en"/.test(page.content || ''); const chineseTitle = page.path.startsWith('about/') ? '關於我' : page.path.startsWith('links/') ? '常用資源' : page.title; %>
<div class="article-layout"><article class="article"><header class="article-header"><a class="back-link" href="/archives/"><%- icon('arrow-left') %> 文章索引</a><div class="article-meta"><% if (page.date) { %><time datetime="<%= page.date.toISOString() %>"><%= page.date.format('YYYY.MM.DD') %></time><% } %><% if(is_post()){ %><span><%= reading_minutes(page) %> 分鐘閱讀</span><% } %></div><h1 lang="zh-Hant" data-title-zh="<%= chineseTitle %>" data-title-en="<%= page.title_en || page.title %>"><%= chineseTitle %></h1><% if(bilingual){ %><div class="language-switch" role="group" aria-label="閱讀語言"><button type="button" data-language-button="zh" aria-pressed="true">中文</button><button type="button" data-language-button="en" aria-pressed="false">English</button></div><% } %></header>
<% if(headings.length){ %><details class="mobile-toc" data-mobile-toc><summary><%- icon('list') %><span>本頁目錄</span><%- icon('chevron-down') %></summary><nav aria-label="本頁目錄"><% headings.forEach(h=> { %><a class="toc-<%= h.level %>" href="#<%= encodeURIComponent(h.id) %>" data-toc-language="<%= h.language %>" <%- h.language === 'en' ? 'lang="en" hidden' : h.language === 'zh' ? 'lang="zh-Hant"' : '' %>><%= h.title %></a><% }); %></nav></details><% } %>
<div class="prose" data-prose><%- page.content %></div>
<% if(is_post()) { %><div class="article-tags"><% page.tags.forEach(tag=> { %><a href="<%= url_for(tag.path) %>"><%= tag.name %></a><% }); %></div><%- partial('_partial/engagement') %><nav class="post-navigation" aria-label="其他文章"><% if(page.prev){ %><a href="<%= url_for(page.prev.path) %>"><span>較新的文章</span><strong><%= page.prev.title %></strong></a><% } %><% if(page.next){ %><a href="<%= url_for(page.next.path) %>"><span>較早的文章</span><strong><%= page.next.title %></strong></a><% } %></nav><% } %>
</article><% if(headings.length){ %><aside class="article-aside" aria-label="文章目錄"><div class="toc-inner"><p>本頁內容</p><nav><% headings.forEach(h=> { %><a class="toc-<%= h.level %>" href="#<%= encodeURIComponent(h.id) %>" data-toc-language="<%= h.language %>" <%- h.language === 'en' ? 'hidden' : '' %>><%= h.title %></a><% }); %></nav><a class="toc-top" href="#main">回到頂端 <%- icon('arrow-up') %></a></div></aside><% } %></div>
