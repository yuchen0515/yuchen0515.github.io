{
  "name": "owen-lin-notes",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node tools/build.mjs",
    "preview": "hexo server --ip 127.0.0.1 --config _config.yml,_config.preview.yml",
    "server": "hexo server --ip 127.0.0.1 --config _config.yml,_config.preview.yml",
    "write": "node tools/writer/server.mjs",
    "new": "node tools/post.mjs new",
    "publish": "node tools/post.mjs publish",
    "check": "node tools/check-site.mjs",
    "test": "node --test tests/*.test.cjs tools/writer/test.mjs",
    "test:browser": "node tests/browser.mjs",
    "release:prepare": "python3 tools/prepare-source.py"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "8.1.2",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-feed": "^3.0.0",
    "hexo-generator-index": "^4.0.0",
    "hexo-generator-sitemap": "^3.0.1",
    "hexo-generator-tag": "^2.0.0",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-server": "^3.0.0",
    "markdown-it": "^15.0.2",
    "markdown-it-anchor": "^9.2.0",
    "@mdit/plugin-katex": "^1.1.3",
    "katex": "^0.18.9",
    "highlight.js": "^11.11.1",
    "cheerio": "^1.1.2",
    "lucide-static": "^0.563.0",
    "mermaid": "^11.12.0"
  },
  "devDependencies": {"playwright": "^1.55.0"},
  "engines": {"node": ">=22.12"}
}
