{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "owen-blog-likes-local",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "dev": { "ip": "127.0.0.1", "port": 8788 },
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGINS": "https://yuchen0515.github.io,http://localhost:4000,http://127.0.0.1:4000",
    "ALLOW_LOCAL_IP_FALLBACK": "true"
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "owen-blog-likes-local", "migrations_dir": "migrations" }
  ],
  "triggers": { "crons": ["17 3 * * *"] }
}
